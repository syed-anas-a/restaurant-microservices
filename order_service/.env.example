# Django
SECRET_KEY=add-your-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DB_NAME=restaurant_order
DB_USER=postgres
DB_PASSWORD=add-your-db-password
DB_HOST=localhost
DB_PORT=5432

# Services
AUTH_SERVICE_URL=http://127.0.0.1:8001
MENU_SERVICE_URL=http://127.0.0.1:8002
CART_SERVICE_URL=http://127.0.0.1:8003

# Service-to-service auth (must match cart_service)
INTERNAL_SERVICE_TOKEN=add-token-for-internal-service-call

# Celery
CELERY_BROKER_URL=redis://127.0.0.1:6379/0

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Email (console backend unless EMAIL_USE_SMTP=True)
EMAIL_USE_SMTP=False
SMTP_USER=
SMTP_PASSWORD=
DEFAULT_FROM_EMAIL=username@example.com 